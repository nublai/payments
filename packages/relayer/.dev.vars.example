# Local development environment variables
# Copy to .dev.vars and fill in values

# Required
RELAYER_MNEMONIC=test test test test test test test test test test test junk
# Chain IDs (comma-separated)
CHAIN_IDS=31337,41337

# Chain-specific RPC URLs (required for multi-chain)
# Pattern: RPC_<chainId>
RPC_31337=http://127.0.0.1:8545
RPC_41337=http://127.0.0.1:8546

# Chain-specific RPC URLs (examples)
# RPC_84532=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# RPC_8453=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# RPC_137=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Pool config (optional)
RELAYER_COUNT=5
MAX_PENDING_PER_SIGNER=16
MAX_PENDING_TOTAL=1000
MIN_SIGNER_BALANCE=0.01
TARGET_SIGNER_BALANCE=0.01

# Contract addresses (optional)
# Names match @nubl/contracts env var keys (no _ADDRESS suffix)
# Use chain-suffixed keys when CHAIN_IDS is set
# ORCHESTRATOR_31337=0x...
# ACCOUNT_31337=0x...
# ACCOUNT_PROXY_31337=0x...
# SIMPLE_FUNDER_31337=0x...
# SIMULATOR_31337=0x...
# ORCHESTRATOR_41337=0x...
# ACCOUNT_41337=0x...
# ACCOUNT_PROXY_41337=0x...
# SIMPLE_FUNDER_41337=0x...
# SIMULATOR_41337=0x...
# local skips quote HMAC when QUOTE_SIGNING_SECRET is unset and leaves ERC-8128 open.
# Stage and prod must set CONTEXT to stage or prod. Unset is not local.
CONTEXT=local

# Fee config. Local may omit FEE_RECIPIENT; the signer address is the fallback.
# Stage and prod must set it (`wrangler secret put FEE_RECIPIENT --env stage`).
# Startup refuses those workers when it is missing. Do not commit the address.
# FEE_RECIPIENT=0x...
# INTENT_GAS_BUFFER=50000
# PAYMENT_GAS_BUFFER=70000
# TX_GAS_BUFFER=50000
# ORCHESTRATOR_OVERHEAD=110000
# PRIORITY_FEE_PERCENTILE=50
# QUOTE_TTL_SECONDS=300

# Validation (optional locally)
# INTENT_EXPIRY_BUFFER_SECONDS=30
# Required on stage and prod (`wrangler secret put QUOTE_SIGNING_SECRET --env stage`).
# Leave unset for local. Do not commit a real secret. When unset and CONTEXT is local,
# quote HMAC is skipped and the relayer still recomputes paymentAmount from gas fields.
# QUOTE_SIGNING_SECRET=

# ERC-8128 allowlist. Comma-separated addresses. Outside local, a key must be listed
# here, or be the intent EOA, or be the session signer on the quote. Empty is not
# "any key". Enforced in local too when set.
# ERC8128_ENABLED=false
# ERC8128_ALLOWED_SIGNERS=

# Privy. Unset enables the provider. Local dev.sh sets PRIVY_ENABLED=false.
# PRIVY_ENABLED=false
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# OIDC (public config, not secrets). WorkOS is the first issuer. All three
# OIDC_ISSUER, OIDC_JWKS_URL, and OIDC_CLIENT_ID are required when OIDC_ENABLED=true.
# An http JWKS URL is refused unless CONTEXT is local. CONTEXT=dev is Base Sepolia
# and does not get that exception.
# OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com
# OIDC_JWKS_URL=https://auth.example.com/oauth2/jwks
# OIDC_CLIENT_ID=client_example
# Wallets claim is off unless the flag is true. An empty claim name stays off.
# OIDC_WALLETS_CLAIM_ENABLED=false
# OIDC_WALLETS_CLAIM=wallets

# CORS (optional). Comma-separated origins. Unset or "*" allows every origin.
# CORS_ALLOWED_ORIGINS=
