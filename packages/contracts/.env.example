# =============================================================================
# Agentic Payments contracts Deployment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Usage: ./scripts/deploy.sh <local|stage|prod> [options]
# =============================================================================

# =============================================================================
# RPC URLs (optional - defaults provided in deploy.sh)
# =============================================================================
# RPC_84532=https://sepolia.base.org
# RPC_8453=https://mainnet.base.org

# =============================================================================
# Local Development (chain 31337)
# =============================================================================
# Default Anvil private key - works out of the box
LOCAL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Test mnemonic for local relayer setup (optional)
RELAYER_MNEMONIC="test test test test test test test test test test test junk"

# Number of relayer signers to derive from mnemonic (default: 10)
# RELAYER_COUNT=10

# =============================================================================
# Dev Environment - Base Sepolia (chain 84532)
# =============================================================================
# Relayer mnemonic for deriving signer addresses
# DEV_RELAYER_MNEMONIC=

# SimpleFunder funder address (who can withdraw gas)
# DEV_FUNDER=0x...

# Owner/deployer address for contract ownership
# DEV_DEPLOYER_ADDRESS=0x...

# =============================================================================
# Stage Environment - Base Mainnet (chain 8453)
# =============================================================================
# Relayer mnemonic for deriving signer addresses
# STAGE_RELAYER_MNEMONIC=

# SimpleFunder funder address (who can withdraw gas)
# STAGE_FUNDER=0x...

# Owner/deployer address for contract ownership
# STAGE_DEPLOYER_ADDRESS=0x...

# =============================================================================
# Production Environment - Base Mainnet (chain 8453)
# =============================================================================
# PROD_RELAYER_MNEMONIC=
# PROD_FUNDER=0x...
# PROD_DEPLOYER_ADDRESS=0x...

# =============================================================================
# LayerZero Settler (optional - for cross-chain settlements)
# =============================================================================
# LayerZero endpoint address (chain-specific)
# Base Sepolia: 0x6EDCE65403992e310A62460808c4b910D972f10f
# Base Mainnet: 0x1a44076050125825900e736c501f859c50fE728c
# LZ_ENDPOINT=0x...

# Authorized signer for LayerZero messages
# LZ_SETTLER_SIGNER=0x...

# =============================================================================
# Block Explorer Verification
# =============================================================================
# ETHERSCAN_API_KEY=
