{
    "name": "@agentic-payments/proto",
    "version": "7.3.1",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "buf:clean": "rm -rf ./src/gen/*",
        "buf:generate": "cd schema && PATH=\"$PWD/../node_modules/.bin:$PATH\" buf generate",
        "buf:lint": "cd schema && PATH=\"$PWD/../node_modules/.bin:$PATH\" buf lint",
        "build": "bun run buf:generate && tsc",
        "cb": "bun run clean && bun run build",
        "clean": "bun run buf:clean && rm -rf ./dist",
        "test": "vitest run",
        "test:ci": "bun run buf:generate && vitest run --silent=passed-only",
        "test:watch": "vitest --watch",
        "watch": "bun scripts/watch_proto_files.cjs",
        "watch:go": "bun scripts/watch_proto_files_go.cjs"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.9.0"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.57.2",
        "@bufbuild/protoc-gen-es": "^2.9.0",
        "@types/node": "^20.14.8",
        "lodash.debounce": "^4.0.8",
        "ts-node": "^10.9.1",
        "typescript": "~5.8.3",
        "vitest": "^3.2.3"
    },
    "files": [
        "/dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./src/index.ts"
    }
}
